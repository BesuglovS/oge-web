# ===========================================
# Oge-Web — Переменные окружения (шаблон)
# Скопируйте в .env и заполните значения
# ===========================================

# ─── Деплой (SSH) ───
# Адрес сервера (хост)
DEPLOY_SSH_HOST=79.143.31.184
# Порт SSH (по умолчанию 22)
DEPLOY_SSH_PORT=22
# Пользователь SSH (deploy — выделенный пользователь деплоя)
DEPLOY_SSH_USER=deploy
# Путь к приватному ключу деплоя (относительно каталога проекта)
DEPLOY_SSH_KEY=../ssh-deploy.key
# Целевая директория на сервере (куда синхронизировать файлы)
DEPLOY_REMOTE_PATH=/var/www/oge.nayanovaacademy.ru/public/
